<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/app_name"
                        android:textColor="#111827"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_pickup_subtitle"
                        android:textColor="#4B5563"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/buttonAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#E5E7EB"
                    android:minHeight="48dp"
                    android:text="@string/home_admin"
                    android:textAllCaps="false"
                    android:textColor="#111827" />
            </LinearLayout>

            <!-- Search entry -->
            <Button
                android:id="@+id/buttonSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#F3F4F6"
                android:gravity="start|center_vertical"
                android:minHeight="56dp"
                android:text="@string/search_products"
                android:textAllCaps="false"
                android:textColor="#4B5563" />

            <!-- Categories -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/home_categories"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="#F3F4F6"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/image_placeholder" />

                    <Button
                        android:id="@+id/buttonHamburgers"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="64dp"
                        android:padding="2dp"
                        android:text="@string/category_hamburgers"
                        android:textAllCaps="false"
                        android:textColor="#111827"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="#F3F4F6"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/image_placeholder" />

                    <Button
                        android:id="@+id/buttonDrinks"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="64dp"
                        android:padding="2dp"
                        android:text="@string/category_drinks"
                        android:textAllCaps="false"
                        android:textColor="#111827"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="#F3F4F6"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/image_placeholder" />

                    <Button
                        android:id="@+id/buttonDesserts"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="64dp"
                        android:padding="2dp"
                        android:text="@string/category_desserts"
                        android:textAllCaps="false"
                        android:textColor="#111827"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Promotion -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:text="@string/home_daily_promotion"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/promotionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F3F4F6"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imagePromotion"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/image_placeholder" />

                <TextView
                    android:id="@+id/textPromotionName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="French Fries" />

                <TextView
                    android:id="@+id/textPromotionPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="CRC 1,800.00" />

                <TextView
                    android:id="@+id/textPromotionDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#4B5563"
                    android:textSize="14sp"
                    tools:text="Crispy french fries." />

                <Button
                    android:id="@+id/buttonPromotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#374151"
                    android:text="@string/home_view_promotion"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/textNoPromotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_no_promotion"
                android:textColor="#4B5563"
                android:visibility="gone" />

            <!-- Pickup branch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#F3F4F6"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_pickup_branch"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textPickupBranch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/select_branch"
                    android:textColor="#4B5563"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/buttonChangeBranch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:backgroundTint="#E5E7EB"
                    android:text="@string/home_change_branch"
                    android:textAllCaps="false"
                    android:textColor="#111827" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F3F4F6"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonNavHome"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:padding="2dp"
            android:text="@string/nav_home"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonNavMenu"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:padding="2dp"
            android:text="@string/nav_menu"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonNavCart"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:padding="2dp"
            android:text="@string/nav_cart"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonNavBranches"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:padding="2dp"
            android:text="@string/nav_branches"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
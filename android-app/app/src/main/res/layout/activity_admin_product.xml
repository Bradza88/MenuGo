<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#E5E7EB">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/admin_example_time"
            android:textColor="#334155"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_mode"
            android:textColor="#334155"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#F1F2F4">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_panel_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1F2937" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_catalog_subtitle"
                android:textSize="13sp"
                android:textColor="#475569"
                android:layout_marginTop="6dp" />
        </LinearLayout>
        <Button
            android:id="@+id/buttonAdminAddProduct"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/admin_add_product"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:backgroundTint="#1F2937"
            android:textColor="#FFFFFF" />
    </LinearLayout>
    <EditText
        android:id="@+id/editAdminSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:hint="@string/admin_search_hint"
        android:textSize="14sp"
        android:textColor="#1F2937"
        android:textColorHint="#475569"
        android:inputType="text"
        android:singleLine="true"
        android:paddingHorizontal="12dp"
        android:background="#F1F2F4" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">
            <LinearLayout
                android:id="@+id/adminProductRow1"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:layout_marginBottom="8dp"
                android:background="#FFFFFF">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/admin_image_placeholder"
                    android:textSize="30sp"
                    android:textColor="#475569"
                    android:background="#F1F2F4" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">
                    <TextView
                        android:id="@+id/textAdminProductName1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_product_classic"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#1F2937"
                        android:maxLines="2" />
                    <TextView
                        android:id="@+id/textAdminProductDetails1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_classic_details"
                        android:textSize="10sp"
                        android:textColor="#475569"
                        android:maxLines="2" />
                </LinearLayout>
                <Button
                    android:id="@+id/buttonAdminEditProduct3"
                    android:layout_width="62dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/admin_edit"
                    android:textAllCaps="false"
                    android:textSize="10sp"
                    android:textColor="#1F2937"
                    android:backgroundTint="#E5E7EB" />
                <Button
                    android:id="@+id/buttonAdminDeleteProduct3"
                    android:layout_width="76dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/admin_delete"
                    android:textAllCaps="false"
                    android:textSize="10sp"
                    android:textColor="#1F2937"
                    android:backgroundTint="#E5E7EB" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/adminProductRow4"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:layout_marginBottom="8dp"
                android:background="#FFFFFF">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/admin_image_placeholder"
                    android:textSize="30sp"
                    android:textColor="#475569"
                    android:background="#F1F2F4" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">
                    <TextView
                        android:id="@+id/textAdminProductName4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_product_soda"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#1F2937"
                        android:maxLines="2" />
                    <TextView
                        android:id="@+id/textAdminProductDetails4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_soda_details"
                        android:textSize="10sp"
                        android:textColor="#475569"
                        android:maxLines="2" />
                </LinearLayout>
                <Button
                    android:id="@+id/buttonAdminEditProduct4"
                    android:layout_width="62dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/admin_edit"
                    android:textAllCaps="false"
                    android:textSize="10sp"
                    android:textColor="#1F2937"
                    android:backgroundTint="#E5E7EB" />
                <Button
                    android:id="@+id/buttonAdminDeleteProduct4"
                    android:layout_width="76dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/admin_delete"
                    android:textAllCaps="false"
                    android:textSize="10sp"
                    android:textColor="#1F2937"
                    android:backgroundTint="#E5E7EB" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#F1F2F4">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/admin_footer_label"
            android:textColor="#475569"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/textAdminBackToCustomer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/admin_back_to_customer"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
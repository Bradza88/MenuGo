<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#F3F4F6"
    android:gravity="top"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imageProduct"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/image_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Classic Burger" />

        <TextView
            android:id="@+id/textProductDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#4B5563"
            android:textSize="14sp"
            tools:text="Beef, cheese, lettuce and tomato." />

        <TextView
            android:id="@+id/textProductPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="CRC 3,000.00" />

        <Button
            android:id="@+id/buttonViewProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:backgroundTint="#E5E7EB"
            android:minHeight="48dp"
            android:text="@string/view_product"
            android:textAllCaps="false"
            android:textColor="#111827" />
    </LinearLayout>

</LinearLayout>
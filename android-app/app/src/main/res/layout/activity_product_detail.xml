<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".ui.activity.ProductDetailActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/buttonBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:backgroundTint="#E5E7EB"
                android:minHeight="48dp"
                android:text="@string/back"
                android:textAllCaps="false"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/textDetailMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingVertical="12dp"
                android:textColor="#111827"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerProductDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageDetailProduct"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/image_placeholder" />

                <TextView
                    android:id="@+id/textDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#374151"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    tools:text="Hamburgers" />

                <TextView
                    android:id="@+id/textDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:accessibilityHeading="true"
                    android:textColor="#111827"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Classic Burger" />

                <TextView
                    android:id="@+id/textDetailPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="CRC 3,000.00" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:text="@string/product_description"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    tools:text="Beef, cheese, lettuce and tomato." />

                <!-- Pickup information -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="#F3F4F6"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pickup_note_title"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/pickup_note_description"
                        android:textColor="#4B5563"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Quantity -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/quantity"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonDecreaseQuantity"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#E5E7EB"
                        android:contentDescription="@string/decrease_quantity"
                        android:minWidth="0dp"
                        android:minHeight="48dp"
                        android:text="@string/quantity_minus"
                        android:textColor="#111827"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/textDetailQuantity"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="1" />

                    <Button
                        android:id="@+id/buttonIncreaseQuantity"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#E5E7EB"
                        android:contentDescription="@string/increase_quantity"
                        android:minWidth="0dp"
                        android:minHeight="48dp"
                        android:text="@string/quantity_plus"
                        android:textColor="#111827"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textDetailSubtotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    tools:text="Subtotal: CRC 3,000.00" />

                <Button
                    android:id="@+id/buttonAddToCart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#374151"
                    android:minHeight="56dp"
                    android:text="@string/add_to_cart"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_navigation" />

</LinearLayout>
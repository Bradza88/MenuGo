<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".ui.activity.CatalogActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/catalog_title"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textProductCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#4B5563"
            android:textSize="14sp"
            tools:text="4 products" />
    </LinearLayout>

    <!-- Search and filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#6B7280"
            android:hint="@string/search_products"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="#111827"
            android:textColorHint="#4B5563"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#E5E7EB"
            android:minHeight="48dp"
            android:text="@string/filters"
            android:textAllCaps="false"
            android:textColor="#111827" />
    </LinearLayout>

    <!-- Product list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/textCatalogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="24dp"
                android:text="@string/products_empty"
                android:textColor="#4B5563"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F3F4F6"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonNavHome"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:padding="2dp"
            android:text="@string/nav_home"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonNavMenu"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:padding="2dp"
            android:text="@string/nav_menu"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonNavCart"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:padding="2dp"
            android:text="@string/nav_cart"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonNavBranches"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="56dp"
            android:padding="2dp"
            android:text="@string/nav_branches"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>